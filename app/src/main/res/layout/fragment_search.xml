<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">



    <!-- Imagem central -->
    <ImageView
        android:id="@+id/ivCenter"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_pokeball"        app:layout_constraintBottom_toTopOf="@+id/etPokemonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Campo de texto (Input) -->
    <EditText
        android:id="@+id/etPokemonName"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="40dp"
        android:background="@color/poke_pink"
        android:hint="@string/hint_nome_pokemon"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:inputType="textPersonName"
        app:layout_constraintBottom_toTopOf="@+id/btnSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivCenter" />

    <!-- Botão Buscar -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:backgroundTint="@color/poke_pink"
        android:textColor="@color/black"
        android:text="@string/btn_buscar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPokemonName" />

</androidx.constraintlayout.widget.ConstraintLayout>