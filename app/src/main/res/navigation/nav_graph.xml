<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash Screen -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.pokeguide.ui.splash.SplashFragment"
        android:label="SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Tela de Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.pokeguide.ui.auth.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- Tela de Cadastro -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.pokeguide.ui.auth.RegisterFragment"
        android:label="RegisterFragment">
        <action
            android:id="@+id/action_registerFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Tela de Busca -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.pokeguide.ui.search.SearchFragment"
        android:label="SearchFragment">
        <action
            android:id="@+id/action_searchFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <!-- Tela da Lista em Grid -->
    <fragment
        android:id="@+id/pokemonListFragment"
        android:name="com.example.pokeguide.ui.list.PokemonListFragment"
        android:label="PokemonListFragment">
        <action
            android:id="@+id/action_pokemonListFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <!-- Tela de Favoritos -->
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.pokeguide.ui.favorites.FavoritesFragment"
        android:label="FavoritesFragment">
        <action
            android:id="@+id/action_favoritesFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_favoritesFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Tela de Detalhes -->
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.pokeguide.ui.detail.DetailFragment"
        android:label="DetailFragment">
        <argument
            android:name="pokemonName"
            app:argType="string" />
    </fragment>

</navigation>